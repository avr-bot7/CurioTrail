# Copy this file to .env (same folder) and fill in ONE key. .env is git-ignored.
# Groq: free, very fast. Get a key at https://console.groq.com (API Keys).
GROQ_API_KEY=
# Or Gemini: free tier. Get a key at https://aistudio.google.com (Get API key).
# GEMINI_API_KEY=
# Optional: force a specific model instead of the automatic choice.
# AI_MODEL=
